# --- 构建产物（可随时删除重建） ---
build/
dist/
.cache/
compile_commands.json
*.user

# --- Agent working memory / internal state — never commit ---
.workbuddy/

# --- 运行时产物：崩溃转储 ---
crashes/
*.dmp

# --- fuzz 每次运行写出的临时报告（正式报告放 docs/verification/） ---
fuzz_report.json

# --- Transient logs ---
# Runtime logs live in <build>/logs and <dist>/logs; both parents are ignored.
*.log
*.log.*
aqtinstall.log

# --- Python caches ---
__pycache__/
*.pyc

# --- Editor / OS cruft ---
Thumbs.db
Desktop.ini
