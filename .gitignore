# --- 构建产物（可随时删除重建） ---
build/
dist/
.cache/
compile_commands.json
*.user

# --- Agent working memory / internal state — never commit ---
.workbuddy/

# --- 运行时产物：崩溃转储 ---
crashes/
*.dmp

# --- Transient logs ---
# Runtime logs live in <build>/logs and <dist>/logs; both parents are ignored.
*.log
*.log.*
aqtinstall.log

# --- Python caches ---
__pycache__/
*.pyc

# --- Editor / OS cruft ---
Thumbs.db
Desktop.ini
