/* ============================================================================
   MEDIA ANALYSE  /  Design System "PRISM"
   A precision-instrument UI kit for Qt Widgets (Qt 5.15+ / Qt 6.x, PySide/PyQt/C++)
   ----------------------------------------------------------------------------
   DESIGN CONTEXT
     User        : the developer, analysing media containers/streams locally
     Job         : file OR one stream URL -> auto-detect protocol -> decode frames
                  -> inspect packet/frame timing -> export TSV
     Personality : precise, calm, credible, instrument-grade
     Anti-ref    : flat charcoal soup, bare status text, unstyled native controls,
                  redundant protocol pickers / transport / auth / timeout fields

   HOW TO LOAD  (PySide6)
     from PySide6.QtCore import QFile, QTextStream
     f = QFile("media-analyzer.qss"); f.open(QFile.ReadOnly | QFile.Text)
     app.setStyleSheet(QTextStream(f).readAll())
   C++: QFile f(":/media-analyzer.qss"); f.open(QFile::ReadOnly); qApp->setStyleSheet(f.readAll());

   OBJECT NAME / DYNAMIC PROPERTY CONTRACT
     Set these in code (setObjectName / setProperty) to opt into the styled parts.
     Containers : AppRoot, AppBar, SourceBar, SourceMode,
                  MetricStrip, NoticeBar, StreamPanel, StreamCard,
                  StreamStatus, TableToolbar, DataView, StatusBar
     QLabel role: eyebrow | title | metric-label | metric-value | meta | muted
                  | status-ok | live | live-stat | proto | warning
     Button var : primary | secondary | ghost | toggle | segment
     Frame var  : video | audio       NoticeBar var: warning | info
     Proto state: detected | unknown (read-only QLabel[role="proto"])
     Input state: unknown (QLineEdit with an unrecognised URL)
     Live state : online | offline    Badge type : I | P | B
     NOTE: QSS has no variables. All hex values below are literal; the token
           table is the single source of truth for delegates drawn in Python/C++.
           Keep qt_reference.py TOKENS in sync when editing this file.

   DESIGN TOKENS  (WCAG AA verified; see contrast report in final handoff)
     bg-base        #14171B   surface-1  #1B1F25   surface-2  #232830
     bg-sunken      #101317   surface-3  #2C333D   border     #363E49
     border-subtle  #2A3038   border-strong #4C5663
     text-primary   #E8EAED   text-secondary #A9B2BE   text-muted #7E8998
     text-disabled  #5B6572
     accent         #E0A44A   accent-hover #EFC06C   accent-press #C68C33
     accent-wash    #33291B   accent-ink  #1A1509
     signal-video   #82A9CC (doubles as live/info notice colour)
     signal-audio   #C99A72
     success #86B49A   warning #E0A44A   error #D97B72
     frame-I #E0A44A   frame-P #82A9CC   frame-B #8A93A0

   TYPE / SPACE / MOTION
     UI   : "Segoe UI", "Microsoft YaHei UI"   Data : "Cascadia Mono", "Consolas"
     Scale: 10 / 11 / 12 / 13 / 15 / 20 px  (fixed px = logical, HiDPI safe)
     Space: 4 8 12 16 20 24 32 48          Control height: 32px (input 34px)
     Row  : 30px   Header: 34px            Radius: 6px (cards 8px)
     Motion: 120ms state changes only, no layout animation (Qt has no CSS
             transitions; implement QPropertyAnimation on colour if desired)
   ============================================================================ */


/* ---------------------------------------------------------------------------
   1. BASE
   --------------------------------------------------------------------------- */
QWidget#AppRoot,
QMainWindow#AppRoot {
    background-color: #14171B;
    color: #E8EAED;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
    selection-background-color: #33291B;
    selection-color: #F2E3C6;
}

QWidget {
    /* Keep descendants transparent so surface colours stay intentional. */
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
}

QToolTip {
    background-color: #2C333D;
    color: #E8EAED;
    border: 1px solid #4C5663;
    border-radius: 4px;
    padding: 6px 9px;
    font-size: 12px;
}

QFrame[frameShape="4"] {           /* HLine / VLine separators */
    color: #2A3038;
    background-color: #2A3038;
    border: none;
    max-height: 1px;
}


/* ---------------------------------------------------------------------------
   2. REGIONS  — hierarchy is built from surface elevation + rules, not cards
   --------------------------------------------------------------------------- */
QFrame#AppBar {
    background-color: #101317;
    border-bottom: 1px solid #2A3038;
    min-height: 46px;
    padding: 0 20px;
}

QFrame#SourceBar {
    background-color: #1B1F25;
    border: 1px solid #2A3038;
    border-radius: 8px;
    padding: 14px 16px;
}

QFrame#MetricStrip {
    background-color: #101317;
    border: 1px solid #2A3038;
    border-radius: 8px;
    padding: 12px 4px;
}

QFrame#NoticeBar {
    background-color: #241E14;
    border: 1px solid #4A3A21;
    border-left: 3px solid #E0A44A;
    border-radius: 6px;
    padding: 9px 12px;
}

QFrame#StreamPanel {
    background-color: transparent;
    border: none;
}

QFrame#StreamCard {
    background-color: #1B1F25;
    border: 1px solid #2A3038;
    border-top: 2px solid #4C5663;
    border-radius: 8px;
    padding: 13px 15px;
}
QFrame#StreamCard[variant="video"] { border-top-color: #82A9CC; }
QFrame#StreamCard[variant="audio"] { border-top-color: #C99A72; }
QFrame#StreamCard:hover { border-color: #363E49; }

QFrame#TableToolbar {
    background-color: #1B1F25;
    border-bottom: 1px solid #2A3038;
    padding: 0 16px;
    min-height: 44px;
}

QFrame#StatusBar {
    background-color: #101317;
    border-top: 1px solid #2A3038;
    padding: 7px 16px;
    min-height: 28px;
}


/* ---------------------------------------------------------------------------
   3. TYPOGRAPHY ROLES
   Qt has no letter-spacing; hierarchy comes from size + weight + colour.
   --------------------------------------------------------------------------- */
QLabel {
    background: transparent;
    color: #E8EAED;
    font-size: 13px;
}

QLabel[role="eyebrow"] {
    color: #7E8998;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;   /* ignored by Qt; use uppercase strings in code */
}

QLabel[role="title"] {
    color: #E8EAED;
    font-size: 15px;
    font-weight: 600;
}

QLabel[role="appname"] {
    color: #E8EAED;
    font-size: 14px;
    font-weight: 600;
}

QLabel[role="brandmark"] {
    color: #E0A44A;
    font-size: 15px;
    font-weight: 700;
}

QLabel[role="metric-label"] {
    color: #7E8998;
    font-size: 10px;
    font-weight: 600;
}

QLabel[role="metric-value"] {
    color: #E8EAED;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 20px;
    font-weight: 500;
}

QLabel[role="metric-unit"] {
    color: #7E8998;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
}

QLabel[role="meta"] {
    color: #A9B2BE;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
}

QLabel[role="muted"]   { color: #7E8998; font-size: 11px; }
QLabel[role="status-ok"] { color: #86B49A; font-size: 11px; font-weight: 600; }
QLabel[role="warning"] { color: #E0A44A; font-size: 12px; }
QLabel[role="field-label"] { color: #A9B2BE; font-size: 11px; font-weight: 600; }
QLabel[role="value"]   { color: #E8EAED; font-size: 12px; font-weight: 600; }

QLabel[role="stream-id"] {
    color: #82A9CC;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    font-weight: 700;
}
QFrame#StreamCard[variant="audio"] QLabel[role="stream-id"] { color: #C99A72; }

QLabel[role="stream-title"] {
    color: #E8EAED;
    font-size: 13px;
    font-weight: 600;
}

/* Frame-type badges are QLabel with a dynamic property; also used by delegate. */
QLabel[role="badge"] {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    font-weight: 700;
    border-radius: 3px;
    padding: 1px 6px;
    background-color: #2C333D;
    color: #A9B2BE;
}
QLabel[role="badge"][type="I"] { background-color: #33291B; color: #E0A44A; border: 1px solid #6B5227; }
QLabel[role="badge"][type="P"] { background-color: #1C2731; color: #82A9CC; border: 1px solid #35506A; }
QLabel[role="badge"][type="B"] { background-color: #232830; color: #A9B2BE; border: 1px solid #363E49; }


/* ---------------------------------------------------------------------------
   4. BUTTONS  — one primary per view, everything else recedes
   --------------------------------------------------------------------------- */
QPushButton {
    background-color: #232830;
    color: #E8EAED;
    border: 1px solid #363E49;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 20px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton:hover   { background-color: #2C333D; border-color: #4C5663; }
QPushButton:pressed { background-color: #1B1F25; border-color: #4C5663; }
QPushButton:focus   { border: 1px solid #E0A44A; }
QPushButton:disabled {
    background-color: #1B1F25;
    color: #5B6572;
    border-color: #2A3038;
}

QPushButton[variant="primary"] {
    background-color: #E0A44A;
    color: #1A1509;
    border: 1px solid #E0A44A;
    font-weight: 700;
}
QPushButton[variant="primary"]:hover   { background-color: #EFC06C; border-color: #EFC06C; }
QPushButton[variant="primary"]:pressed { background-color: #C68C33; border-color: #C68C33; }
QPushButton[variant="primary"]:disabled {
    background-color: #33291B; color: #7E8998; border-color: #33291B;
}

QPushButton[variant="secondary"] {
    background-color: #232830; color: #E8EAED; border: 1px solid #363E49;
}
QPushButton[variant="ghost"] {
    background-color: transparent; color: #A9B2BE; border: 1px solid transparent;
}
QPushButton[variant="ghost"]:hover { background-color: #232830; color: #E8EAED; }

QPushButton[variant="toggle"] {
    background-color: #1B1F25;
    color: #A9B2BE;
    border: 1px solid #363E49;
    text-align: left;
    padding: 6px 12px;
}
QPushButton[variant="toggle"]:checked {
    background-color: #33291B;
    color: #E0A44A;
    border-color: #6B5227;
    font-weight: 600;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 5px;
    color: #A9B2BE;
    min-width: 22px; min-height: 22px;
}
QToolButton:hover   { background-color: #232830; color: #E8EAED; }
QToolButton:pressed { background-color: #2C333D; }
QToolButton:disabled { color: #5B6572; }


/* ---------------------------------------------------------------------------
   4b. INPUT SOURCE — local file / network stream
   The mode switch is a first-class control, not a hidden menu item.
   --------------------------------------------------------------------------- */
QFrame#SourceMode {
    background-color: #101317;
    border: 1px solid #363E49;
    border-radius: 7px;
    padding: 2px;
}
QPushButton[variant="segment"] {
    background-color: transparent;
    color: #7E8998;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 5px 13px;
    min-height: 16px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton[variant="segment"]:hover   { color: #E8EAED; }
QPushButton[variant="segment"]:checked {
    background-color: #2C333D;
    color: #E8EAED;
    border-color: #2C333D;
}
QPushButton[variant="segment"]:focus  { border-color: #E0A44A; }

/* The URL is the ONLY input for a network stream. The protocol is derived
   from the address; the detected name is a read-out label, never a control.
   Deliberately absent: protocol picker, transport/buffer combos, credentials,
   timeout, reconnect switch and window-size settings. */
QLabel[role="proto"] {
    color: #82A9CC;
    background-color: #1C2731;
    border: 1px solid #35506A;
    border-radius: 5px;
    padding: 5px 10px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 10px;
    font-weight: 600;
}
QLabel[role="proto"][state="unknown"] {
    color: #D97B72;
    background-color: #2B1D1C;
    border-color: #A05B50;
}
QLineEdit[state="unknown"]          { border-color: #A05B50; }
QLineEdit[state="unknown"]:focus    { border-color: #A05B50; }

QFrame#StreamStatus { border: none; border-top: 1px solid #2A3038; }
QLabel[role="live"] {
    color: #E0A44A;
    background-color: #33291B;
    border: 1px solid #6B5227;
    border-radius: 4px;
    padding: 3px 8px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 10px;
    font-weight: 700;
}
QLabel[role="live"][state="offline"] {
    color: #A9B2BE;
    background-color: #232830;
    border-color: #363E49;
}
QLabel[role="live-stat"] {
    color: #A9B2BE;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
}

/* LIVE mode swaps the amber warning for a steel-blue informational notice. */
QFrame#NoticeBar[variant="info"] {
    background-color: #16232B;
    border-color: #2F4B5B;
    border-left-color: #82A9CC;
}
QFrame#NoticeBar[variant="info"] QLabel[role="warning"] { color: #C3D6E4; }


/* ---------------------------------------------------------------------------
   5. INPUTS
   --------------------------------------------------------------------------- */
QLineEdit {
    background-color: #101317;
    color: #E8EAED;
    border: 1px solid #363E49;
    border-radius: 6px;
    padding: 7px 11px;
    min-height: 20px;
    selection-background-color: #33291B;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
}
QLineEdit:hover   { border-color: #4C5663; }
QLineEdit:focus   { border-color: #E0A44A; background-color: #14171B; }
QLineEdit:disabled { color: #5B6572; border-color: #2A3038; background-color: #14171B; }
/* Placeholder: set via QLineEdit.setPlaceholderText(); colour is QPalette
   PlaceholderText -> #7E8998 (4.6:1 on #101317), NOT the Qt default light grey. */

QComboBox {
    background-color: #232830;
    color: #E8EAED;
    border: 1px solid #363E49;
    border-radius: 6px;
    padding: 6px 28px 6px 11px;
    min-height: 20px;
    font-size: 12px;
}
QComboBox:hover { border-color: #4C5663; }
QComboBox:focus { border-color: #E0A44A; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid #2A3038;
}
QComboBox QAbstractItemView {
    background-color: #1B1F25;
    color: #E8EAED;
    border: 1px solid #363E49;
    border-radius: 6px;
    selection-background-color: #33291B;
    selection-color: #F2E3C6;
    padding: 4px;
    outline: none;
}

QCheckBox, QRadioButton {
    color: #A9B2BE;
    font-size: 12px;
    spacing: 8px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px; height: 15px;
    background-color: #101317;
    border: 1px solid #4C5663;
    border-radius: 3px;
}
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #E0A44A; }
QCheckBox::indicator:checked {
    background-color: #E0A44A;
    border-color: #E0A44A;
    /* supply a 12px SVG tick via  image: url(:/icons/check.svg); */
}
QRadioButton::indicator:checked { background-color: #E0A44A; border-color: #E0A44A; }
QCheckBox:disabled, QRadioButton:disabled { color: #5B6572; }


/* ---------------------------------------------------------------------------
   6. TABS  — segmented, with counts; active = accent rule, not a filled pill
   --------------------------------------------------------------------------- */
QTabWidget::pane {
    border: none;
    background-color: #14171B;
    top: -1px;
}
QTabBar {
    background-color: transparent;
    qtabbar-align: left;
}
QTabBar::tab {
    background-color: transparent;
    color: #7E8998;
    padding: 12px 18px 11px 18px;
    margin-right: 4px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 13px;
    font-weight: 500;
    min-width: 84px;
}
QTabBar::tab:hover   { color: #E8EAED; background-color: #1B1F25; }
QTabBar::tab:selected {
    color: #E8EAED;
    font-weight: 600;
    border-bottom: 2px solid #E0A44A;
    background-color: #1B1F25;
}
QTabBar::tab:focus { border-bottom: 2px solid #E0A44A; }


/* ---------------------------------------------------------------------------
   7. DATA TABLE  — the primary surface; everything here optimises scanning
   --------------------------------------------------------------------------- */
QTableView, QTableWidget {
    background-color: #101317;
    alternate-background-color: #161A20;
    color: #E8EAED;
    gridline-color: #22272E;
    border: 1px solid #2A3038;
    border-radius: 6px;
    selection-background-color: #33291B;
    selection-color: #F2E3C6;
    padding: 0px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    outline: none;
}
QTableView::item, QTableWidget::item {
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid #1B1F25;
}
QTableView::item:hover, QTableWidget::item:hover { background-color: #232830; }
QTableView::item:selected, QTableWidget::item:selected {
    background-color: #33291B;
    color: #F2E3C6;
}
/* Selected-row accent rule and frame-type chips are drawn by the delegate
   (see qt_reference.py FrameTypeDelegate) — QSS cannot target a single column. */

QHeaderView {
    background-color: #1B1F25;
    border: none;
}
QHeaderView::section {
    background-color: #1B1F25;
    color: #A9B2BE;
    padding: 9px 10px;
    border: none;
    border-right: 1px solid #2A3038;
    border-bottom: 1px solid #363E49;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 11px;
    font-weight: 600;
}
QHeaderView::section:hover { background-color: #232830; color: #E8EAED; }
QHeaderView::section:first { border-top-left-radius: 6px; }
QHeaderView::section:last  { border-top-right-radius: 6px; border-right: none; }
QTableCornerButton::section {
    background-color: #1B1F25;
    border: none;
    border-right: 1px solid #2A3038;
    border-bottom: 1px solid #363E49;
}

/* Vertical row-number column: quieter than data, but still AA (5.07:1). */
QTableView QLabel[role="rownum"] { color: #7E8998; }


/* ---------------------------------------------------------------------------
   8. SCROLLBARS  — thin, no arrow buttons, no page noise
   --------------------------------------------------------------------------- */
QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #101317;
    border: none;
}
QScrollBar:vertical   { width: 10px; margin: 0; }
QScrollBar:horizontal { height: 10px; margin: 0; }
QScrollBar::handle:vertical {
    background-color: #3A424E;
    min-height: 40px;
    border: 2px solid #101317;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background-color: #3A424E;
    min-width: 40px;
    border: 2px solid #101317;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover { background-color: #4C5663; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }


/* ---------------------------------------------------------------------------
   9. MISC
   --------------------------------------------------------------------------- */
QMenu {
    background-color: #1B1F25;
    color: #E8EAED;
    border: 1px solid #363E49;
    border-radius: 6px;
    padding: 5px;
}
QMenu::item { padding: 7px 24px 7px 12px; border-radius: 4px; font-size: 12px; }
QMenu::item:selected { background-color: #33291B; color: #F2E3C6; }
QMenu::separator { height: 1px; background-color: #2A3038; margin: 4px 6px; }

QProgressBar {
    background-color: #101317;
    border: 1px solid #2A3038;
    border-radius: 4px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk { background-color: #E0A44A; border-radius: 3px; }

QSplitter::handle { background-color: #2A3038; }
QSplitter::handle:hover { background-color: #E0A44A; }

QStatusBar {
    background-color: #101317;
    color: #7E8998;
    border-top: 1px solid #2A3038;
    font-size: 11px;
}
QStatusBar::item { border: none; }


/* ---------------------------------------------------------------------------
   10. ACCESSIBILITY NOTES (implementation contract)
     - All text/background pairs above meet WCAG AA 4.5:1; component borders
       meet 3:1. Placeholder must be set to #7E8998 via QPalette, not Qt default.
     - Never encode meaning by colour alone: frame type uses letter + chip,
       stream type uses text + top rule + colour.
     - Keep keyboard focus visible (`:focus` border on every interactive control).
     - Disable animations when the OS requests reduced motion; no infinite
       spinners or blinking indicators in this instrument-style UI.
     - 32px control height is intentional for a mouse-driven dense desktop tool;
       do not shrink below 28px.
   --------------------------------------------------------------------------- */
