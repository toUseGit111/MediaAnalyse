{
  "version": 6,
  "configurePresets": [
    {
      "name": "win-mingw",
      "displayName": "Windows MinGW (portable toolchain)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "D:/CodeTools/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "D:/CodeTools/mingw64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "D:/CodeTools/mingw64/bin/ninja.exe",
        "MA_FFMPEG_ROOT": "D:/CodeTools/ffmpeg-n9.0-latest-win64-gpl-shared-9.0",
        "MA_FFMPEG_RUNTIME_DLL_DIR": "D:/CodeTools/ffmpeg-n9.0-latest-win64-gpl-shared-9.0/bin"
      }
    },
    {
      "name": "win-mingw-app",
      "inherits": "win-mingw",
      "displayName": "Windows MinGW + Qt Quick app",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "D:/CodeTools/Qt/Tools/mingw1510_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "D:/CodeTools/Qt/Tools/mingw1510_64/bin/g++.exe",
        "MA_ENABLE_APP": "ON",
        "CMAKE_PREFIX_PATH": "D:/CodeTools/Qt/6.10.3/mingw_64",
        "MA_QT_RUNTIME_DIR": "D:/CodeTools/Qt/6.10.3/mingw_64/bin"
      }
    }
  ],
  "buildPresets": [
    { "name": "win-mingw", "configurePreset": "win-mingw" },
    { "name": "win-mingw-app", "configurePreset": "win-mingw-app" }
  ]
}
